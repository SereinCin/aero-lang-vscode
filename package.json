{
  "name": "aero-lang",
  "displayName": "Aero Language",
  "description": "Syntax highlighting + LSP client for the Aero programming language.",
  "version": "1.1.0",
  "publisher": "serein",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "aero",
    "language",
    "syntax",
    "highlighting",
    "lsp"
  ],
  "icon": "icon.png",
  "license": "MIT",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:aero"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aero",
        "aliases": [
          "Aero",
          "aero"
        ],
        "extensions": [
          ".aero"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aero",
        "scopeName": "source.aero",
        "path": "./syntaxes/aero.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Aero",
      "properties": {
        "aero.lsp.executablePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the aero compiler binary. When set, the extension spawns `aero --lsp` for real-time diagnostics. Leave empty for syntax highlighting only."
        }
      }
    }
  }
}