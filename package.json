{
  "name": "aero-lang",
  "displayName": "Aero Language",
  "description": "Lightweight support for the Aero programming language: syntax highlighting, language config, and one-key compile/run in the integrated terminal.",
  "version": "0.1.0",
  "publisher": "serein",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "aero",
    "language",
    "compiler"
  ],
  "icon": "icon.png",
  "license": "MIT",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:aero"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aero",
        "aliases": [
          "Aero",
          "aero"
        ],
        "extensions": [
          ".aero"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aero",
        "scopeName": "source.aero",
        "path": "./syntaxes/aero.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aero",
        "path": "./snippets/aero.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "aero.run",
        "title": "Aero: Run File",
        "icon": "$(play)"
      },
      {
        "command": "aero.build",
        "title": "Aero: Build File",
        "icon": "$(tools)"
      }
    ],
    "keybindings": [
      {
        "command": "aero.run",
        "key": "ctrl+alt+r",
        "when": "editorTextFocus && editorLangId == aero"
      },
      {
        "command": "aero.build",
        "key": "ctrl+alt+b",
        "when": "editorTextFocus && editorLangId == aero"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "aero.run",
          "group": "navigation@1",
          "when": "editorLangId == aero"
        },
        {
          "command": "aero.build",
          "group": "navigation@2",
          "when": "editorLangId == aero"
        }
      ],
      "editor/context": [
        {
          "command": "aero.run",
          "group": "aero@1",
          "when": "editorLangId == aero"
        },
        {
          "command": "aero.build",
          "group": "aero@2",
          "when": "editorLangId == aero"
        }
      ],
      "explorer/context": [
        {
          "command": "aero.run",
          "group": "aero@1",
          "when": "resourceLangId == aero"
        },
        {
          "command": "aero.build",
          "group": "aero@2",
          "when": "resourceLangId == aero"
        }
      ]
    },
    "configuration": {
      "title": "Aero",
      "properties": {
        "aero.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the aero compiler executable. Empty = resolve via AERO_HOME env var, then PATH."
        }
      }
    }
  }
}
